tablice indeksowane
$cars= array ("volvo", "bmw", "toyota");

$cars=  ["volvo", "bmw", "toyota"];

$cars=[];
$cars=[0]="opel";
$cars=[1]="toyota";
$cars=[2]="bmw";

tablice asocjacyjne
$age=array("peter"=>"35", "ben"=>"20", "joe"=>"64");

$age=["peter"=>"35", "ben"=>"20", "joe"=>"64"];

$age['peter']="35";
$age['ben']="20";
$age['joe']="64";

print_r($zmienna) wypisuje cala tablice

count()

<?php
  $cars=array("volvo", "bmw", "toyota");
  echo "size of array cars=".count($cars);

sortowanie tablic
<?php
  $cars=array("volvo", "bmw", "toyota");
 sort ($cars);
print_r($cars);

rsort($cars);
print_r($cars);


kasowanie ostaniego elemntu tablicy
array_pop

<?php
  $a=array("red", "green","blue");
array_pop($a);
print_r($a);

array push dodanie lementu na koniec
<?php
  $a=array("red","green");
  array_push($a,"blue","yellow");
print_r($a);

array shift usuwa pierwszy element array_shift()
<?php
 $a=array("a"=>"red","b"=>"green", "c"=>"blue");
  echo array_shift($a). "<br>";
print_r($a);


array_unshift() dodaje elemnty na poczatek

<?php
$a=array("a"=>"red","b"=>"green", "c"=>"blue");
array_unshift($a,"blue");
print_r($a);
?>





